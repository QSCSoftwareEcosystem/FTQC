#===- FTQCConfig.cmake.in - Package config for installed FTQC -------------===#
#
# Generated by CMake. Consumers find this via:
#   find_package(FTQC REQUIRED CONFIG HINTS <install-prefix>/lib/cmake/FTQC)
#
#===-----------------------------------------------------------------------===#

@PACKAGE_INIT@

# Provide install-tree include and lib dirs.
set_and_check(FTQC_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(FTQC_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

# Locate the MLIR/LLVM packages that FTQC was built against.
find_package(MLIR REQUIRED CONFIG HINTS "@MLIR_DIR@")
find_package(LLVM REQUIRED CONFIG HINTS "@LLVM_DIR@")

# Import the exported FTQC targets.
include("${CMAKE_CURRENT_LIST_DIR}/FTQCTargets.cmake")

check_required_components(FTQC)
